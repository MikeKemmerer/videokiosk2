# videokiosk2 local configuration
# Copy this file to local.conf and fill in your values.
# This file is sourced by vlc-wrapper.sh at runtime.
STREAM_URL="http://your-stream-server:8086/0.ts"
BROWSER_URL="http://your-calendar-server:8000"
# Use direct ALSA output for a specific HDMI device when needed.
# AUDIO_OUTPUT="alsa"
# ALSA_AUDIO_DEVICE="hdmi:CARD=PCH,DEV=0"
# Optional override: set to "midori" or "falkon" to bypass OS detection.
# FAILOVER_BROWSER="falkon"

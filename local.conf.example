# videokiosk2 local configuration
# Copy this file to local.conf and fill in your values.
# This file is sourced by vlc-wrapper.sh at runtime.
STREAM_URL="http://your-stream-server:8086/0.ts"
BROWSER_URL="http://your-calendar-server:8000"
# Use direct ALSA output for a specific HDMI device when needed.
# List available HDMI identifiers with: aplay -L | grep '^hdmi:'
# AUDIO_OUTPUT="alsa"
# ALSA_AUDIO_DEVICE="hdmi:CARD=PCH,DEV=0"
# Optional override: set to "midori" or "falkon" to bypass OS detection.
# FAILOVER_BROWSER="falkon"
# Falkon UI scale. Supported values: 1, 1.25, 1.5, 1.75, 2, 2.5, 3, or 4.
# BROWSER_SCALE="1"
# Minutes to keep the failover browser visible before running tvStandby.sh.
# Set to 0 to disable the standby hook timer.
# STANDBY_AFTER_MINUTES="60"
# Set to true after installing Bluetooth HID control for a paired Fire TV.
# FIRETV_BLUETOOTH_ENABLED="false"
# Pair Fire TV power with the X11 output so HDMI cannot remain off after wake.
# FIRETV_DISPLAY_OUTPUT="HDMI1"
# FIRETV_DISPLAY_MODE="1920x1080"
# FIRETV_DISPLAY_RATE="60"
# Paired Fire TV Bluetooth address plus its network MAC/broadcast for WOL.
# FIRETV_BLUETOOTH_TARGET="AA:BB:CC:DD:EE:FF"
# FIRETV_NETWORK_MAC="11:22:33:44:55:66"
# FIRETV_NETWORK_BROADCAST="192.0.2.255"

# ntfy push alerts (optional): set the topic in /etc/videokiosk2/ntfy-topic,
# e.g. `echo YOUR_TOPIC | sudo tee /etc/videokiosk2/ntfy-topic`. Never commit
# the topic value; anyone who knows it can read and send to it on ntfy.sh.
# videokiosk2.service, videokiosk2-scheduler.service and
# videokiosk2-gpio-restart.service all alert on crash via systemd
# OnFailure=; the VLC wrapper also alerts on its own ERROR-level log lines
# (freeze/CPU-stuck detection, failover browser failures).
